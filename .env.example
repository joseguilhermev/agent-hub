# Local SQLite database path. Use an absolute, persistent path in production.
AGENT_HUB_DATABASE=data/agent-hub.db

# Required in production: a stable Fernet key used to encrypt Direct Line
# secrets at rest. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the real value in a secrets manager and never rotate it without
# re-encrypting the stored agent secrets first.
AGENT_HUB_ENCRYPTION_KEY=
